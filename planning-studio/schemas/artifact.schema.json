{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimoi.local/schemas/planning-studio/artifact.schema.json",
  "title": "Guild Planning Studio Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_id",
    "version",
    "record_type",
    "title",
    "status",
    "path"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "capture",
        "source",
        "research_artifact",
        "initiative",
        "proposal",
        "review",
        "decision",
        "pattern",
        "promotion"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "initiative_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes": {
      "type": "string"
    }
  }
}

