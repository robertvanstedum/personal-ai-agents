# COS Agent A runtime configuration (development)
# Copy names into the repository-root .env and supply values locally.
# Never commit real values.

# Independent gateway credential. Generate a new random value; do not reuse the
# personal OpenClaw Gateway token.
COS_AGENT_A_GATEWAY_TOKEN=

# Select Agent A for the COS service. The legacy Grok backend remains the
# explicit rollback value.
COS_BACKEND_TYPE=openclaw

# Agent A receives only the shared gateway credential. Provider credentials,
# concrete model IDs, and fallback order belong to the LiteLLM service.
MINIMOI_MODEL_GATEWAY_KEY=
