# MinimoI shared model gateway (development)
# Copy variable names into the repository-root .env and keep real values local.

# Independent client credential used by OpenClaw and future domain consumers.
# Generate a long random value prefixed with "sk-". Never reuse a provider key.
MINIMOI_MODEL_GATEWAY_KEY=
MINIMOI_MODEL_GATEWAY_RECEIPT_KEY=

# Provider credentials are supplied only to the gateway container.
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Native Ollama endpoint on the Mac host; do not append /v1.
MINIMOI_OLLAMA_URL=http://host.docker.internal:11434
