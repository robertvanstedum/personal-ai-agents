{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "type": "string"
    },
    "dependencies": {
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "[0-9a-f]{64}",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generation": {
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "schema_version": {
      "const": "minimoi.intelligence/1.0"
    },
    "state_hash": {
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "synthetic": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "generation",
    "captured_at",
    "files",
    "dependencies",
    "state_hash",
    "synthetic"
  ],
  "title": "manifest",
  "type": "object"
}
