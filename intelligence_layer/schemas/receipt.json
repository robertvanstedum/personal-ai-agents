{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "operation": {
      "enum": [
        "designate",
        "promote",
        "relation",
        "delete",
        "classify"
      ]
    },
    "principal": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "minimoi.intelligence/1.0"
    },
    "target_hash": {
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "principal",
    "operation",
    "target_hash",
    "created_at",
    "receipt_id"
  ],
  "title": "receipt",
  "type": "object"
}
