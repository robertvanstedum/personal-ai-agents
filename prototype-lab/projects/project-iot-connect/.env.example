# IoT Connect standalone beta — local configuration example.
# Copy to .env and adjust only if the defaults collide with something on
# your machine. Every value here is synthetic; nothing is a live credential.

# Host ports (delivered defaults — keep 8095/8096 stable for Swagger/Postman)
IOTCONNECT_APP_PORT=8095
IOTCONNECT_INTEGRATIONS_PORT=8096
IOTCONNECT_DB_PORT=54329

# Local PostgreSQL (container-internal; the password is deliberately not secret)
IOTCONNECT_DB_NAME=iotconnect
IOTCONNECT_DB_USER=iotconnect_app
IOTCONNECT_DB_PASSWORD=iotconnect-local-demo-password

# URL prefix when IoT Connect runs behind a reverse proxy (portal path
# /app/iotconnect). Leave empty for the standalone stack.
IOTCONNECT_ROOT_PATH=

# Trusted-identity mode. local_demo (default): the UI/Postman send X-Demo-Role /
# X-Demo-Account-ID. minimoi_proxy: hosted behind the mini-moi portal, which
# strips X-Demo-* and forwards portal-verified X-Minimoi-User-Tier (only
# "owner" is authorised), X-Minimoi-Username, X-Minimoi-Auth-Id.
IOTCONNECT_AUTH_MODE=local_demo

# Deterministic seed timestamp used by reset (ISO-8601, UTC)
IOTCONNECT_SEED_TIMESTAMP=2026-08-01T00:00:00+00:00
