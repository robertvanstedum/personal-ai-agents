{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "update": {
    "checkOnStart": false
  },
  "models": {
    "catalogRefresh": {
      "enabled": false
    }
  },
  "plugins": {
    "allow": [
      "memory-core",
      "anthropic",
      "xai",
      "openai",
      "minimoi-tools",
      "mc-bounded-search"
    ],
    "entries": {
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "minimoi-tools": {
        "enabled": true,
        "config": {
          "enabled": true,
          "endpoint": "http://127.0.0.1:5011/internal/mc/v1/tools",
          "tokenFile": "/home/node/.minimoi-tools/executor.token",
          "agents": [
            "mc-chat"
          ],
          "tools": [
            "minimoi_agent_contact",
            "minimoi_agent_status",
            "minimoi_agent_watch",
            "minimoi_artifact_recover",
            "minimoi_board_note_create",
            "minimoi_board_note_read",
            "minimoi_board_note_update",
            "minimoi_board_notes_query",
            "minimoi_board_operation_read",
            "minimoi_board_operation_undo",
            "minimoi_clarify_action",
            "minimoi_conversation_export",
            "minimoi_data_repair_ticket",
            "minimoi_delegate_build",
            "minimoi_delegate_research",
            "minimoi_describe_domain",
            "minimoi_describe_house",
            "minimoi_github_issues",
            "minimoi_guest_request_reject",
            "minimoi_guest_requests",
            "minimoi_host_health",
            "minimoi_host_list",
            "minimoi_host_read",
            "minimoi_issue_comment",
            "minimoi_keep_preference",
            "minimoi_lesson_propose",
            "minimoi_recall",
            "minimoi_record_gap",
            "minimoi_revoke_preference",
            "minimoi_withdraw_gap",
            "minimoi_working_write"
          ],
          "diskPaths": [
            "/",
            "/minimoi/work"
          ],
          "hostPython": "/usr/bin/python3",
          "hostHelper": "/opt/minimoi/mc-agent/helpers/inspect.py",
          "hostArtifactHelper": "/opt/minimoi/mc-agent/helpers/artifact.py",
          "hostArtifactRoot": "${MC_ARTIFACT_ROOT}",
          "hostDeniedPaths": [
            "/home/node/.claude",
            "/home/node/.config",
            "/home/node/.openclaw",
            "/home/node/.minimoi-tools",
            "/proc",
            "/run/secrets"
          ],
          "allowTokenReadableByAgent": false
        }
      },
      "mc-bounded-search": {
        "enabled": true
      }
    },
    "load": {
      "paths": [
        "/opt/minimoi/mc-agent/plugins/minimoi-tools",
        "/opt/minimoi/mc-agent/plugins/mc-bounded-search"
      ]
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "tools": {
    "sessions": {
      "visibility": "self"
    },
    "agentToAgent": {
      "enabled": false
    },
    "toolSearch": false,
    "links": {
      "enabled": false
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "minimoi",
        "maxResults": 20,
        "timeoutSeconds": 60,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": false
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "anthropic/claude-opus-5"
      },
      "models": {
        "anthropic/claude-opus-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        },
        "anthropic/claude-sonnet-4-6": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        }
      },
      "modelPolicy": {
        "allow": [
          "anthropic/claude-opus-5",
          "anthropic/claude-sonnet-4-6"
        ]
      }
    },
    "entries": {
      "mc-agent": {
        "name": "Master Craftsman",
        "workspace": "/home/node/.openclaw/workspace-mc",
        "agentDir": "/home/node/.openclaw/agents/mc-agent",
        "model": {
          "primary": "anthropic/claude-opus-5",
          "fallbacks": []
        },
        "memory": {
          "search": {
            "enabled": false,
            "rememberAcrossConversations": false
          }
        },
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "full",
          "deny": [
            "group:messaging",
            "group:nodes",
            "group:automation",
            "group:ui",
            "cron",
            "gateway",
            "sessions_spawn",
            "sessions_send",
            "subagents",
            "agents_list",
            "web_fetch"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      "mc-chat": {
        "name": "Master Craftsman (conversation)",
        "workspace": "/home/node/.openclaw/workspace-mc",
        "agentDir": "/home/node/.openclaw/agents/mc-chat",
        "model": {
          "primary": "anthropic/claude-opus-5",
          "fallbacks": []
        },
        "memory": {
          "search": {
            "enabled": false,
            "rememberAcrossConversations": false
          }
        },
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "full",
          "deny": [
            "group:messaging",
            "group:nodes",
            "group:automation",
            "group:ui",
            "cron",
            "gateway",
            "sessions_spawn",
            "sessions_send",
            "subagents",
            "agents_list",
            "web_fetch"
          ],
          "elevated": {
            "enabled": false
          },
          "fs": {
            "workspaceOnly": true
          }
        }
      }
    }
  },
  "session": {
    "reset": {
      "mode": "none"
    }
  }
}
