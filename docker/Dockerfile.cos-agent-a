# OpenClaw current stable, pinned by multi-arch index digest.
FROM ghcr.io/openclaw/openclaw:2026.9.6@sha256:0a5ff5e682e62afa19149df126aa50063bf65ef885b5c94713ce32dc0eb12e15

# Never self-update inside the container; releases move only through this pin.
ENV OPENCLAW_NO_AUTO_UPDATE=1

# The pinned gateway config lives in the image, root-owned (read-only to the
# node user), and apply-config.sh (git mode 755; COPY keeps it executable)
# copies it over the state volume's openclaw.json on every start (Docker seeds
# image files only into a newly created volume, so existing staging and
# production volumes would otherwise keep an old config). Credentials remain
# runtime env vars; the config only names them.
COPY --chown=root:root docker/cos-agent-a/openclaw.json /opt/minimoi/cos-agent-a/openclaw.json
COPY --chown=root:root docker/cos-agent-a/apply-config.sh /opt/minimoi/cos-agent-a/apply-config.sh

# Seed a newly created state volume (config + agent workspace policy).
COPY --chown=node:node docker/cos-agent-a/openclaw.json /home/node/.openclaw/openclaw.json
COPY --chown=node:node docker/cos-agent-a/AGENTS.md /home/node/.openclaw/workspace-cos-agent-a/AGENTS.md
COPY --chown=node:node docker/cos-agent-a/IDENTITY.md /home/node/.openclaw/workspace-cos-agent-a/IDENTITY.md
COPY --chown=node:node docker/cos-agent-a/SOUL.md /home/node/.openclaw/workspace-cos-agent-a/SOUL.md
COPY --chown=node:node docker/cos-agent-a/MEMORY.md /home/node/.openclaw/workspace-cos-agent-a/MEMORY.md
COPY --chown=node:node docker/cos-agent-a/plugins/cos-bounded-search /opt/minimoi/openclaw-plugins/cos-bounded-search

# Staging only (Master Craftsman stage 1a, MC spec v0.7 §1.2 and §1.4): the
# combined CoS + MC config, MC's workspace seed, and the start script with its
# self-check. Dormant here: nothing below changes production's start path.
# Production keeps apply-config.sh and the CoS-only openclaw.json; only the
# staging overlay docker-compose.staging-mc.yml selects start-with-mc.sh.
COPY --chown=root:root docker/cos-agent-a/openclaw.cos-mc.json /opt/minimoi/cos-agent-a/openclaw.cos-mc.json
COPY --chown=root:root docker/cos-agent-a/start-with-mc.sh /opt/minimoi/cos-agent-a/start-with-mc.sh
COPY --chown=root:root docker/cos-agent-a/selfcheck.mjs /opt/minimoi/cos-agent-a/selfcheck.mjs
COPY --chown=root:root docker/cos-agent-a/mc-agent/workspace/ /opt/minimoi/cos-agent-a/mc-agent/workspace/

# Same init and command as the upstream image, with the config step in front.
ENTRYPOINT ["tini", "-s", "--", "/opt/minimoi/cos-agent-a/apply-config.sh"]
CMD ["node", "openclaw.mjs", "gateway"]

# The release this image was built from (scripts/staging/build.sh passes it;
# "unknown" elsewhere). start-with-mc.sh keys a sticky MC self-check failure
# on it, because the image digest cannot be read inside the container.
ARG MINIMOI_RELEASE_SHA=unknown
ENV MINIMOI_RELEASE_SHA=${MINIMOI_RELEASE_SHA}
