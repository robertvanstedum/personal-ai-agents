FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

WORKDIR /app

COPY docker/requirements.cos-agent.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ core/
COPY utils/ utils/
COPY domains/guild/ domains/guild/
COPY domains/cos/ domains/cos/
# The frozen CoS contracts: the store writer validates every command against them at runtime.
COPY contracts/cos/ contracts/cos/
COPY services/model_gateway/ services/model_gateway/
COPY services/usage/ services/usage/
# The portal's sandboxed upload reader, loaded by path for CoS Confer attachments (domains/cos/files.py).
COPY minimoi_portal/guild_ui/doc_reader.py minimoi_portal/guild_ui/doc_reader.py

ENV PORT=8769
ENV PYTHONPATH=/app
EXPOSE 8769

CMD ["python", "domains/cos/chief_of_staff.py"]
