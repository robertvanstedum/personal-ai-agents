# Pinned by digest: the base production's running portal was built from (TR1 build, 60c553f7).
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

WORKDIR /app

COPY docker/requirements.portal.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV FLASK_ENV=production
ENV PORT=5001

EXPOSE 5001

CMD ["python", "minimoi_portal/app.py"]
