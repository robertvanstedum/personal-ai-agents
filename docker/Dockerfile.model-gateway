FROM ghcr.io/berriai/litellm-non_root@sha256:6363e53f135dafbf4a68fac25f77aec3f2b99be37665e8c5f623a952637c220b

# Production uses an immutable application image rather than mutable host
# config mounts. Provider credentials remain runtime environment variables.
COPY services/model_gateway/litellm.prod.yaml /app/config.yaml
COPY services/model_gateway/receipt_callback.py /app/receipt_callback.py
# The usage recorder, named by the config above. It writes nothing unless the environment sets MINIMOI_USAGE_DIR.
COPY services/usage/usage_record.py /app/usage_record.py
COPY services/usage/litellm_recorder.py /app/usage_recorder.py
