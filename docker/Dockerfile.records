# Records (Rooms) for STAGING ONLY (Guild 1.1 slice 4, spec §6). Never part of
# a production deploy (scripts/ci/classify_release.py: dormant); it runs in
# its own Compose project (docker-compose.records.yml, scripts/staging/records.sh)
# on an internal network with no host port. The portal reaches it at
# http://minimoi-records:18880 through its dev-only bridge (/app/records/).
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

WORKDIR /app

COPY docker/requirements.records.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY domains/records/ /app/domains/records/
# Preserve the existing container command through the lightweight launcher.
COPY prototype-lab/projects/project-records-room-poc/app.py prototype-lab/projects/project-records-room-poc/manage.py prototype-lab/projects/project-records-room-poc/roomctl.py prototype-lab/projects/project-records-room-poc/accessctl.py /app/
RUN rm -rf /app/domains/records/static/v2/fixtures

ENV PYTHONDONTWRITEBYTECODE=1
EXPOSE 18880

# The SQLite file and its private key files live in /data, a host folder
# (${MINIMOI_ROOT}/data/records, mode 700). On first start Records creates
# owner-key.txt there unless the owner put his own one in place first.
CMD ["python", "app.py", "--data-dir", "/data", "--host", "0.0.0.0", "--port", "18880"]
