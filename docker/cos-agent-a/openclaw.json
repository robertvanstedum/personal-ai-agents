{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18790",
        "http://localhost:18790"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "update": {
    "checkOnStart": false
  },
  "models": {
    "catalogRefresh": {
      "enabled": false
    },
    "providers": {
      "minimoi-gateway": {
        "baseUrl": "http://model-gateway:4000/v1",
        "apiKey": "${MINIMOI_MODEL_GATEWAY_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "minimoi-cos-agent",
            "name": "MinimoI COS Agent",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "allow": [
      "memory-core",
      "anthropic",
      "xai",
      "openai",
      "cos-bounded-search",
      "mc-cutoff-delivery",
      "cos-bound",
      "cos-board",
      "cos-github"
    ],
    "load": {
      "paths": [
        "/opt/minimoi/openclaw-plugins/cos-bounded-search",
        "/opt/minimoi/openclaw-plugins/mc-cutoff-delivery",
        "/opt/minimoi/openclaw-plugins/cos-bound",
        "/opt/minimoi/openclaw-plugins/cos-board",
        "/opt/minimoi/openclaw-plugins/cos-github"
      ]
    },
    "entries": {
      "cos-bounded-search": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "mc-cutoff-delivery": {
        "enabled": true
      },
      "cos-bound": {
        "enabled": true,
        "config": {
          "enabled": true,
          "endpoint": "http://cos-scheduler:8771/internal/cos/v1",
          "tokenFile": "/run/secrets/cos-bound/token",
          "agents": [
            "cos-agent-a",
            "cos-meeting"
          ],
          "acceptCredentialReadableBy": [
            "cos-agent-a"
          ]
        }
      },
      "cos-board": {
        "enabled": true
      },
      "cos-github": {
        "enabled": true
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "minimoi",
        "maxResults": 20,
        "timeoutSeconds": 60,
        "cacheTtlMinutes": 15
      }
    },
    "profile": "minimal",
    "exec": {
      "mode": "full"
    },
    "toolSearch": false
  },
  "agents": {
    "defaults": {
      "imageModel": {
        "primary": "minimoi-gateway/minimoi-cos-agent"
      },
      "model": {
        "primary": "minimoi-gateway/minimoi-cos-agent"
      },
      "modelPolicy": {
        "allow": [
          "minimoi-gateway/minimoi-cos-agent"
        ]
      },
      "bootstrapMaxChars": 32000,
      "bootstrapTotalMaxChars": 64000
    },
    "entries": {
      "cos-agent-a": {
        "name": "COS Agent A",
        "workspace": "/home/node/.openclaw/workspace-cos-agent-a",
        "model": {
          "primary": "minimoi-gateway/minimoi-cos-agent",
          "fallbacks": []
        },
        "modelPolicy": {
          "allow": [
            "minimoi-gateway/minimoi-cos-agent"
          ]
        },
        "skills": [],
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read",
            "ls",
            "write",
            "edit",
            "exec",
            "web_search",
            "web_fetch",
            "memory_search",
            "memory_get",
            "pdf",
            "view_image",
            "cos_actions",
            "cos_board",
            "cos_github_issues"
          ],
          "deny": [
            "gateway"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      "cos-meeting": {
        "name": "COS meeting",
        "workspace": "/home/node/.openclaw/workspace-cos-meeting",
        "model": {
          "primary": "minimoi-gateway/minimoi-cos-agent",
          "fallbacks": []
        },
        "modelPolicy": {
          "allow": [
            "minimoi-gateway/minimoi-cos-agent"
          ]
        },
        "skills": [],
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "web_search",
            "cos_actions"
          ],
          "deny": [
            "gateway",
            "group:fs",
            "group:runtime",
            "read",
            "ls",
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "web_fetch",
            "browser",
            "memory_search",
            "memory_get",
            "pdf",
            "view_image",
            "cos_board",
            "cos_github_issues"
          ],
          "fs": {
            "workspaceOnly": true
          },
          "elevated": {
            "enabled": false
          }
        }
      }
    }
  }
}
