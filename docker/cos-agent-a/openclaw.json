{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18790",
        "http://localhost:18790"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "update": {
    "checkOnStart": false
  },
  "models": {
    "catalogRefresh": {
      "enabled": false
    },
    "providers": {
      "minimoi-gateway": {
        "baseUrl": "http://model-gateway:4000/v1",
        "apiKey": "${MINIMOI_MODEL_GATEWAY_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "minimoi-cos-agent",
            "name": "MinimoI COS Agent",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/minimoi/openclaw-plugins/cos-bounded-search",
        "/opt/minimoi/openclaw-plugins/mc-cutoff-delivery"
      ]
    },
    "entries": {
      "cos-bounded-search": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "mc-cutoff-delivery": {
        "enabled": true
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "minimoi",
        "maxResults": 20,
        "timeoutSeconds": 60,
        "cacheTtlMinutes": 15
      }
    },
    "profile": "full",
    "exec": {
      "mode": "full"
    }
  },
  "agents": {
    "defaults": {
      "imageModel": {
        "primary": "minimoi-gateway/minimoi-cos-agent"
      },
      "model": {
        "primary": "minimoi-gateway/minimoi-cos-agent"
      },
      "modelPolicy": {
        "allow": [
          "minimoi-gateway/minimoi-cos-agent"
        ]
      },
      "bootstrapMaxChars": 32000,
      "bootstrapTotalMaxChars": 64000
    },
    "entries": {
      "cos-agent-a": {
        "name": "COS Agent A",
        "workspace": "/home/node/.openclaw/workspace-cos-agent-a",
        "model": {
          "primary": "minimoi-gateway/minimoi-cos-agent",
          "fallbacks": []
        },
        "modelPolicy": {
          "allow": [
            "minimoi-gateway/minimoi-cos-agent"
          ]
        },
        "skills": [],
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "profile": "full"
        }
      }
    }
  }
}
