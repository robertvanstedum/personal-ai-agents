{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18790",
        "http://localhost:18790"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true,
          "maxBodyBytes": 262144
        }
      }
    }
  },
  "models": {
    "providers": {
      "minimoi-gateway": {
        "baseUrl": "http://model-gateway:4000/v1",
        "apiKey": "${MINIMOI_MODEL_GATEWAY_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "minimoi-cos-agent",
            "name": "MinimoI COS Agent",
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "list": [
      {
        "id": "cos-agent-a",
        "default": true,
        "name": "COS Agent A",
        "workspace": "/home/node/.openclaw/workspace-cos-agent-a",
        "model": {
          "primary": "minimoi-gateway/minimoi-cos-agent",
          "fallbacks": []
        },
        "skills": [],
        "heartbeat": {
          "every": "0m"
        },
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "allow": [
            "session_status"
          ],
          "deny": [
            "group:fs",
            "group:runtime",
            "group:web",
            "group:ui",
            "group:messaging",
            "cron",
            "gateway",
            "nodes",
            "sessions_spawn",
            "subagents"
          ],
          "elevated": {
            "enabled": false
          }
        }
      }
    ]
  }
}
