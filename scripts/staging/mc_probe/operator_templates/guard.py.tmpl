"""Dev-only fixed-route proxy: conservative daily estimates and hard call/token limits.

Actual vendor reporting stays in the upstream gateway. This is a runaway guard,
not an invoice or a promise of an exact monetary ceiling. No automatic retries.
"""
import datetime, hashlib, hmac, http.server, json, os, sqlite3, threading, time
import urllib.request, urllib.error
from pathlib import Path
from zoneinfo import ZoneInfo

LOCK=threading.Lock()
DB='/state/model-admission.sqlite'
MAX_CALLS=@@MAX_CALLS@@  # Historical admissions plus reviewed new-call allowance.
BASE_DAY=@@DAY@@
BASE_CALLS=@@BASE_CALLS@@
BASE_MICRO=@@BASE_MICRO@@  # Prior actual charges and unresolved reservations remain counted.
WINDOW_MICRO=@@WINDOW_MICRO@@
MAX_OUTPUT_TOKENS=@@MAX_OUTPUT_TOKENS@@
MAX_SECONDS=900
MAX_BODY=400000
MODEL='minimoi-cos-agent'
UPSTREAM_MODEL='minimoi-mc-agent'  # Operator verifies the configured model; no gateway fallback chain.

POLICY_FILE=Path('/state/expected-policy.txt')
POLICY_MARKER='# Isolated dev reviewer: active proving policy'

def policy_evidence(messages):
    """Content-free evidence of the operator-pinned policy in the actual provider request."""
    try:
        expected=POLICY_FILE.read_text(encoding='utf-8')
        if not expected or len(expected)>40000:raise ValueError('invalid_policy_size')
    except (OSError,UnicodeError,ValueError):
        return {'policy_expected':False}
    def content(message):
        value=message.get('content','')
        if isinstance(value,str):return value
        if isinstance(value,list):
            return '\n'.join(x['text'] for x in value if isinstance(x,dict) and isinstance(x.get('text'),str))
        return ''
    system='\n'.join(content(m) for m in messages if isinstance(m,dict) and m.get('role') in ('system','developer'))
    normalized=' '.join(system.split())
    prefix=expected.split('\n---\n',1)[0].strip()
    return {'policy_expected':True,'expected_policy_sha256':hashlib.sha256(expected.encode()).hexdigest(),
            'policy_normalized_in_system':' '.join(expected.split()) in normalized,
            'policy_prefix_in_system':prefix in system,
            'policy_prefix_normalized_in_system':' '.join(prefix.split()) in normalized,
            'policy_in_system':expected.strip() in system,
            'policy_marker_in_system':POLICY_MARKER in system}

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,*args,**kwargs):return None

def credentials():
    token=os.environ.get('PROVING_PROXY_TOKEN','')
    upstream=os.environ.get('UPSTREAM_KEY','')
    # LiteLLM generates sk- plus 22 random URL-safe characters (25 total).
    if len(token)<32 or len(upstream)<25:
        raise ValueError('strong_proxy_and_upstream_credentials_required')
    return token,upstream

def admit(body_bytes):
    day=datetime.datetime.now(ZoneInfo('America/Chicago')).date().isoformat()
    if day != BASE_DAY: raise ValueError('review_new_day_required')
    # Pessimistic one token per serialized byte, highest cache-write rate, plus
    # 2048 formatting tokens and the reviewed output cap. Estimates are not invoices.
    bound_micro=(body_bytes+2048)*@@INPUT_RATE@@ + MAX_OUTPUT_TOKENS*@@OUTPUT_RATE@@
    with LOCK:
        try:
            armed=json.loads(Path('/state/armed.json').read_text())
            expires=float(armed['expires_epoch'])
        except (OSError,ValueError,KeyError,TypeError):
            raise ValueError('operator_has_not_armed_run') from None
        if not 0 < expires-time.time() <= MAX_SECONDS:
            raise ValueError('run_time_limit')
        db=sqlite3.connect('file:'+DB+'?mode=rw',uri=True)
        try:
            with db:
                db.execute('BEGIN IMMEDIATE')
                count=db.execute('SELECT COUNT(*) FROM calls').fetchone()[0]
                if count>=MAX_CALLS: raise ValueError('daily_call_limit')
                priced=db.execute('SELECT COUNT(*),COALESCE(SUM(micro),0) FROM bounds_@@RUN_SQL@@').fetchone()
                if count != BASE_CALLS+priced[0]: raise ValueError('unpriced_admission')
                if priced[1]+bound_micro>WINDOW_MICRO or BASE_MICRO+priced[1]+bound_micro>25000000:
                    raise ValueError('mixed_price_budget_limit')
                cur=db.execute('INSERT INTO calls(day,at) VALUES (?,?)',(day,datetime.datetime.now(datetime.timezone.utc).isoformat()))
                db.execute('INSERT INTO bounds_@@RUN_SQL@@(call_id,micro) VALUES (?,?)',(cur.lastrowid,bound_micro))
        finally: db.close()
    return count+1

def clamp_output(body):
    completion_limit=body.pop('max_completion_tokens',MAX_OUTPUT_TOKENS)
    body['max_tokens']=min(int(body.get('max_tokens',MAX_OUTPUT_TOKENS)),int(completion_limit),MAX_OUTPUT_TOKENS)
    if body['max_tokens']<1:raise ValueError('invalid_token_limit')

class Handler(http.server.BaseHTTPRequestHandler):
    def setup(self):
        super().setup();self.connection.settimeout(125)
    def log_message(self,*args): pass
    def answer(self,status,body):
        raw=json.dumps(body).encode();self.send_response(status)
        self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw)
    def do_POST(self):
        if self.path!='/v1/chat/completions':return self.answer(404,{'error':'unsupported_route'})
        try: token,upstream_key=credentials()
        except ValueError:return self.answer(503,{'error':'guard_not_configured'})
        if not hmac.compare_digest(self.headers.get('Authorization','').encode('utf-8'),('Bearer '+token).encode('utf-8')):
            return self.answer(401,{'error':'not_authorized'})
        try:
            n=int(self.headers.get('Content-Length','0'))
            if not 0<n<=MAX_BODY:raise ValueError('request_size')
            body=json.loads(self.rfile.read(n))
            if not isinstance(body,dict) or body.get('model')!=MODEL:raise ValueError('fixed_model_required')
            # Upstream destinations, API keys and background work cannot be selected by the caller.
            allowed={'model','messages','tools','tool_choice','temperature','top_p','stop','max_tokens','max_completion_tokens','stream','stream_options','user','parallel_tool_calls'}
            if set(body)-allowed:
                print(json.dumps({'event':'unsupported_parameters','names':sorted(set(body)-allowed)}),flush=True)
                raise ValueError('unsupported_parameter')
            if not isinstance(body.get('messages'),list):raise ValueError('messages_required')
            clamp_output(body)
            evidence=policy_evidence(body['messages'])
            admitted_call=admit(max(n,len(json.dumps(body).encode())))
            print(json.dumps({"event":"admitted","body_bytes":n,"daily_call":admitted_call,**evidence}),flush=True)
        except (ValueError,TypeError,sqlite3.Error) as exc:
            known={'request_size','fixed_model_required','unsupported_parameter','messages_required','invalid_token_limit','operator_has_not_armed_run','run_time_limit','daily_call_limit','review_new_day_required','unpriced_admission','mixed_price_budget_limit'}
            print(json.dumps({'event':'refused','reason':str(exc) if str(exc) in known else type(exc).__name__}),flush=True)
            return self.answer(429,{'error':'proving_admission_refused'})
        headers_sent=False
        try:
            body.pop('user',None)
            body['model']=UPSTREAM_MODEL
            req=urllib.request.Request('http://minimoi-model-gateway:4000/v1/chat/completions',data=json.dumps(body).encode(),headers={'Authorization':'Bearer '+upstream_key,'Content-Type':'application/json'})
            opener=urllib.request.build_opener(NoRedirect(),urllib.request.ProxyHandler({}))
            with opener.open(req,timeout=120) as response:
                raw=response.read(1000001)
                if len(raw)>1000000:raise ValueError('upstream_response_size')
                content_type=response.headers.get('Content-Type','application/json')
                if not body.get('stream'):json.loads(raw)
                self.send_response(200);headers_sent=True;self.send_header('Content-Type',content_type)
                self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw)
        except Exception:
            # Failed attempts remain admitted/charged estimates; never retry here.
            if headers_sent:self.close_connection=True
            else:self.answer(502,{'error':'upstream_failed_no_retry'})

if __name__=='__main__':
    credentials()
    with sqlite3.connect('file:'+DB+'?mode=rw',uri=True) as db:
        db.execute('SELECT COUNT(*) FROM calls').fetchone()
    http.server.ThreadingHTTPServer(('0.0.0.0',4000),Handler).serve_forever()
