{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimoi:contract:cos:incident",
  "title": "Emergencies: raise, incident, channel attempt, acknowledgment",
  "description": "Spec v0.3 section 4.10. Owned and run by the supervisor container, independent of the portal. Classes E1-E4 only; a routine nudge has no path to raise_incident. Acknowledgment suppresses future sends; it cannot recall one in flight.",
  "oneOf": [
    { "$ref": "#/$defs/raise" },
    { "$ref": "#/$defs/incident" },
    { "$ref": "#/$defs/attempt" },
    { "$ref": "#/$defs/acknowledgment" }
  ],
  "$defs": {
    "class": {
      "description": "E1 production down or data-loss risk; E2 security or credential exposure; E3 spend past the caps; E4 a commitment Robert marked must-not-miss.",
      "enum": ["E1", "E2", "E3", "E4"]
    },
    "channel": { "enum": ["telegram", "email", "chat"] },
    "raise": {
      "description": "Arguments of raise_incident(class, dedup_key, evidence_ref, raised_by_seat). Idempotent on dedup_key: CoS and MC raising the same incident create one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "class", "dedup_key", "evidence_ref", "raised_by_seat", "data_scope", "environment", "one_line"],
      "properties": {
        "schema": { "const": "minimoi.cos.incident_raise/1" },
        "class": { "$ref": "#/$defs/class" },
        "dedup_key": { "type": "string", "pattern": "^E[1-4]:[a-z0-9][a-z0-9._:-]{0,120}$" },
        "evidence_ref": { "$ref": "urn:minimoi:contract:cos:common#/$defs/typed_ref" },
        "raised_by_seat": { "enum": ["cos", "mc", "supervisor"] },
        "data_scope": { "$ref": "urn:minimoi:contract:cos:common#/$defs/data_scope" },
        "environment": { "$ref": "urn:minimoi:contract:cos:common#/$defs/environment" },
        "one_line": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "E4" } } },
          "then": { "properties": { "evidence_ref": { "properties": { "type": { "const": "cos.obligation" } } } } }
        }
      ]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "class", "dedup_key", "state", "opened_at", "raised_by", "evidence_ref", "one_line", "data_scope", "environment"],
      "properties": {
        "schema": { "const": "minimoi.cos.incident/1" },
        "id": { "$ref": "urn:minimoi:contract:cos:common#/$defs/id" },
        "class": { "$ref": "#/$defs/class" },
        "dedup_key": { "type": "string", "pattern": "^E[1-4]:[a-z0-9][a-z0-9._:-]{0,120}$" },
        "state": {
          "description": "acknowledged and recovered are separate: Robert seeing it is not the problem being fixed.",
          "enum": ["open", "acknowledged", "recovered", "closed"]
        },
        "opened_at": { "$ref": "urn:minimoi:contract:cos:common#/$defs/timestamp" },
        "acknowledged_at": { "$ref": "urn:minimoi:contract:cos:common#/$defs/nullable_timestamp" },
        "recovered_at": { "$ref": "urn:minimoi:contract:cos:common#/$defs/nullable_timestamp" },
        "raised_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cos", "mc", "supervisor"] }
        },
        "evidence_ref": { "$ref": "urn:minimoi:contract:cos:common#/$defs/typed_ref" },
        "one_line": { "type": "string", "minLength": 1, "maxLength": 200 },
        "recovery_note": { "type": ["string", "null"], "maxLength": 500 },
        "data_scope": { "$ref": "urn:minimoi:contract:cos:common#/$defs/data_scope" },
        "environment": { "$ref": "urn:minimoi:contract:cos:common#/$defs/environment" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "acknowledged" } } }, "then": { "properties": { "acknowledged_at": { "type": "string" } } } },
        { "if": { "properties": { "state": { "const": "recovered" } } }, "then": { "properties": { "recovered_at": { "type": "string" } } } }
      ]
    },
    "attempt": {
      "description": "One delivery attempt on one channel. accepted means the channel took it, never that Robert read it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "incident_id", "attempt_id", "channel", "n", "state", "at"],
      "properties": {
        "schema": { "const": "minimoi.cos.incident_attempt/1" },
        "incident_id": { "$ref": "urn:minimoi:contract:cos:common#/$defs/id" },
        "attempt_id": { "$ref": "urn:minimoi:contract:cos:common#/$defs/id" },
        "channel": { "$ref": "#/$defs/channel" },
        "n": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["attempted", "accepted", "refused", "unknown"] },
        "at": { "$ref": "urn:minimoi:contract:cos:common#/$defs/timestamp" },
        "code": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "note_id": {
          "description": "chat only: the deterministic stream note id.",
          "type": "string",
          "pattern": "^incident:[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "allOf": [
        { "if": { "properties": { "channel": { "const": "chat" } } }, "then": { "required": ["note_id"] } }
      ]
    },
    "acknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "incident_id", "via", "at", "proof"],
      "properties": {
        "schema": { "const": "minimoi.cos.incident_ack/1" },
        "incident_id": { "$ref": "urn:minimoi:contract:cos:common#/$defs/id" },
        "via": { "enum": ["telegram_reply", "minimoi_button", "email_link"] },
        "at": { "$ref": "urn:minimoi:contract:cos:common#/$defs/timestamp" },
        "proof": {
          "description": "telegram_reply: the bound reply to the incident's exact message (core/supervision/telegram.py). minimoi_button: the owner session. email_link: a signed single-use token, served by the portal.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "enum": ["bound_reply", "owner_session", "signed_link"] },
            "ref": { "$ref": "urn:minimoi:contract:cos:common#/$defs/id" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "via": { "const": "telegram_reply" } } }, "then": { "properties": { "proof": { "properties": { "kind": { "const": "bound_reply" } } } } } },
        { "if": { "properties": { "via": { "const": "minimoi_button" } } }, "then": { "properties": { "proof": { "properties": { "kind": { "const": "owner_session" } } } } } },
        { "if": { "properties": { "via": { "const": "email_link" } } }, "then": { "properties": { "proof": { "properties": { "kind": { "const": "signed_link" } } } } } }
      ]
    }
  }
}
