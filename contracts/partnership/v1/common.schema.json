{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimoi:contract:partnership:common",
  "title": "Shared definitions for the partnership task service",
  "description": "Partnership and team workflow spec v1.1, sections 2, 3 and 8. Every other schema in this folder references these. The CoS contracts (contracts/cos/v1) stay frozen; this is a separate, versioned contract.",
  "$defs": {
    "timestamp": {
      "description": "ISO 8601 with an explicit offset. Recorded for people; never used to order events across stores (Q01).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "tz": {
      "type": "string",
      "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+)+)$"
    },
    "environment": {
      "description": "synthetic marks fixtures and acceptance runs; a synthetic record is never evidence about dev, staging or prod.",
      "enum": [
        "synthetic",
        "dev",
        "staging",
        "prod"
      ]
    },
    "data_scope": {
      "description": "Whose data. personal, or a named shared scope. A reader holding no grant for a scope never learns that a record in it exists (Q07).",
      "type": "string",
      "pattern": "^(personal|shared:[a-z0-9][a-z0-9-]{0,40})$"
    },
    "seat": {
      "description": "A registered seat (principal, CoS, MC, a builder, a worker). Open registry (seats.json); registering a seat confers no capability (P02).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "nullable_seat": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "description": "Derived from the authenticated credential, never declared by the caller (A02). owner_session is the only origin that can carry owner authority.",
      "enum": [
        "owner_session",
        "agent",
        "platform",
        "peer",
        "scheduler"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^SE-[A-Za-z0-9_-]{4,64}$"
    },
    "interpretation_id": {
      "type": "string",
      "pattern": "^IN-[A-Za-z0-9_-]{4,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^RQ-[A-Za-z0-9_-]{4,64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TK-[A-Za-z0-9_-]{4,64}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{3,120}$"
    },
    "nullable_task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/task_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_interpretation_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/interpretation_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "ref": {
      "description": "A pointer into another authoritative store (Records event, harness attempt, artifact edition, obligation occurrence, grant). The task service never copies the referenced authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "id"
      ],
      "properties": {
        "store": {
          "enum": [
            "records",
            "task_service",
            "harness",
            "artifacts",
            "obligations",
            "grants",
            "practice",
            "learning",
            "notices",
            "billing_fixture",
            "external",
            "cos_in_flight",
            "build_log",
            "lead_wake"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "digest": {
          "$ref": "#/$defs/nullable_digest"
        }
      }
    },
    "runtime": {
      "description": "Who actually produced a record: the model/provider/build/config for model work, or the implementation for deterministic work (Q01). Unknown stays null; never inferred.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "model",
            "deterministic",
            "human"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "config_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "return_window": {
      "description": "C09. Absolute time with its zone and the basis it came from, so the principal can correct it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "timezone",
        "basis"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "timezone": {
          "$ref": "#/$defs/tz"
        },
        "basis": {
          "enum": [
            "verified_meeting",
            "default_0800_next_day",
            "stated_by_principal",
            "agreed_in_conversation"
          ]
        },
        "basis_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "nullable_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "description": "E01-E03. One identity for an outbound operation across stores; the destination dedups on it.",
      "type": "string",
      "pattern": "^OB-[A-Za-z0-9_-]{4,64}$"
    }
  }
}
