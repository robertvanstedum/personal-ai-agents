{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimoi:contract:common",
  "title": "Shared definitions for the Rooms and operations UI contracts",
  "description": "First version (package U). Referenced by every other schema in this folder. Fixture data carries \"simulated\": true; live API responses never carry the key.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "nullable_timestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "simulated": {
      "const": true,
      "description": "Present only on preview fixture data. The HTTP adapter refuses any payload that contains this key."
    },
    "schema_id": {
      "type": "string",
      "pattern": "^minimoi\\.[a-z_]+\\.[a-z_]+/[0-9]+$"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "nullable_principal_id": {
      "oneOf": [{ "$ref": "#/$defs/principal_id" }, { "type": "null" }]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/principal_id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["person", "agent", "service"] }
      }
    },
    "freshness": {
      "description": "Computed from the receiving clock, never from the source's own clock.",
      "enum": ["current", "stale", "unavailable", "unknown"]
    },
    "contact_source": { "enum": ["heartbeat", "checkpoint"] },
    "nullable_contact_source": {
      "oneOf": [{ "$ref": "#/$defs/contact_source" }, { "type": "null" }]
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_id": { "type": "string", "pattern": "^rec-[a-z0-9]{2,32}$" },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision"],
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "citation": {
      "description": "Exact span: source@revision#segment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "ordinal"],
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "revision": { "type": "integer", "minimum": 1 },
        "ordinal": { "type": "integer", "minimum": 1 }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citation" }
    },
    "fidelity": { "enum": ["original", "excerpt", "extraction", "reconstruction"] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "missing", "note"],
      "properties": {
        "state": { "enum": ["complete", "partial", "unknown"] },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "note": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "complete" } } },
          "then": { "properties": { "missing": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "partial" } } },
          "then": { "anyOf": [{ "properties": { "missing": { "minItems": 1 } } }, { "properties": { "note": { "type": "string", "minLength": 1 } } }] }
        }
      ]
    },
    "execution": {
      "enum": ["queued", "claimed", "running", "waiting", "outcome_uncertain", "finished", "failed", "cancelled"]
    },
    "delivery": { "enum": ["local_only", "central_ack_pending", "centrally_recorded"] },
    "assurance_level": {
      "description": "Highest assurance stage reached, each backed by its own evidence and authority.",
      "enum": ["none", "produced", "builder_verified", "independently_reviewed", "accepted", "released"]
    },
    "wait_reason": { "enum": ["tool", "input", "review", "host", "quota", "sign_in", "schedule"] },
    "nullable_wait_reason": {
      "oneOf": [{ "$ref": "#/$defs/wait_reason" }, { "type": "null" }]
    },
    "work_ref": {
      "description": "Typed reference to existing work.",
      "type": "string",
      "pattern": "^(build_queue|coordination|work_artifact|record):[A-Za-z0-9._:@-]{1,80}$"
    },
    "disposition": {
      "description": "Who recorded a disposition and when. Owner acceptance is never set by a builder, monitor or model.",
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "authority", "disposition_id"],
      "properties": {
        "by": { "$ref": "#/$defs/principal_id" },
        "at": { "$ref": "#/$defs/timestamp" },
        "authority": { "enum": ["owner", "reviewer"] },
        "disposition_id": { "type": "string", "pattern": "^disp-[a-z0-9-]{1,40}$" }
      }
    },
    "absent": {
      "description": "The resource could not be read (store unavailable) or does not exist. Consumers render Unknown or Not found, never zero or empty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "code", "observed_at", "detail"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "simulated": { "$ref": "#/$defs/simulated" },
        "status": { "enum": ["unavailable", "not_found"] },
        "code": { "enum": ["store_unavailable", "not_found"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "detail": { "type": "string", "minLength": 1 },
        "subject": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "code": { "const": "store_unavailable" } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_found" } } },
          "then": { "properties": { "code": { "const": "not_found" } } }
        }
      ]
    }
  }
}
